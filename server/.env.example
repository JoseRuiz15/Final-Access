# Required backend settings (replace these values for your local database)
DATABASE_URL=postgresql://user:password@localhost:5432/final_acces
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECRET=replace-with-another-random-secret-of-at-least-32-characters
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email delivery: use "console" for local codes, or "smtp" to send real email
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM="Final Acces <your-account@gmail.com>"
