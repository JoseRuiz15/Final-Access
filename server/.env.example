# ============================================
# CONEXIÓN NEON (PostgreSQL serverless)
# ============================================
# Conexión pooled (recomendada para runtime)
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Conexión unpooled (para drizzle-kit migrate / studio)
DATABASE_URL_UNPOOLED="postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ============================================
# SECRETOS (generar con: openssl rand -base64 32)
# ============================================
JWT_SECRET=""
COOKIE_SECRET=""
JWT_EXPIRES_IN="15m"

# ============================================
# ENTORNO
# ============================================
NODE_ENV="development"
PORT=3000

# Orígenes permitidos por CORS, separados por coma.
# En producción: https://tu-frontend.vercel.app,https://tu-frontend-abc.vercel.app
FRONTEND_URL="http://localhost:5173"

# Cookie de sesión.
# COOKIE_DOMAIN vacío = cookie host-only. NO pongas .vercel.app ni .railway.app:
# los navegadores los rechazan por ser public suffixes.
# Con frontend y backend en dominios distintos hace falta COOKIE_SAME_SITE=none
# (y entonces COOKIE_SECURE debe ser true).
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# ============================================
# EMAIL ("console" imprime el código de verificación en la terminal)
# ============================================
EMAIL_TRANSPORT="console"
EMAIL_FROM=""
EMAIL_VERIFICATION_TTL_MIN=10
EMAIL_RATE_LIMIT_MAX=3
# Intentos máximos para teclear el código de 6 dígitos (fuerza bruta).
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ============================================
# SMTP (solo si EMAIL_TRANSPORT="smtp" o NODE_ENV="production")
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
