# ============================================
# VARIABLES PARA RAILWAY (backend)
# ============================================
# Copia este bloque en:
#   Railway > tu servicio > Variables > Raw > Add Variable
#
# En Neon usa la URL "Pooled connection" (NO la unpooled):
# la unpooled se queda sin conexiones y el pooler no aguanta el tráfico.
# ============================================

# --- Base de datos (Neon) ---
# Formato: postgresql://usuario:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# El servidor usa `ssl: 'require'` (pool.ts), así que la URL DEBE incluir sslmode=require.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Secretos (genera cada uno con: openssl rand -base64 32) ---
# Mínimo 32 caracteres o el servidor no arranca (validación con Zod).
JWT_SECRET=""
COOKIE_SECRET=""
JWT_EXPIRES_IN="15m"

# --- Entorno ---
# Nixpacks ya pone NODE_ENV=production; se deja explícito por si acaso.
NODE_ENV="production"

# --- CORS: orígenes permitidos, separados por coma ---
# El frontend en Vercel y el backend en Railway son sitios distintos:
# el navegador exige credenciales + SameSite=None + Secure.
# Añade aquí los previews de Vercel si los usas:
# FRONTEND_URL="https://tu-frontend.vercel.app,https://tu-frontend-abc.vercel.app"
FRONTEND_URL="https://tu-frontend.vercel.app"

# --- Cookie de sesión ---
# COOKIE_DOMAIN vacío a propósito: .vercel.app y .railway.app son public
# suffixes y los navegadores rechazan las cookies que los incluyen.
COOKIE_DOMAIN=""
COOKIE_SECURE="true"
COOKIE_SAME_SITE="none"

# --- Email (OBLIGATORIO en producción) ---
# En producción el transporte SMTP está forzado (emailService.ts): con
# EMAIL_TRANSPORT="console" el código de verificación se imprime en el log
# en vez de enviarse, y el registro de usuarios quedaría incompleto.
# EMAIL_FROM debe ser un remitente verificado por el proveedor SMTP.
# En Gmail, SMTP_PASS es la CONTRASEÑA DE APLICACIÓN (16 caracteres),
# no la contraseña normal de la cuenta.
EMAIL_FROM="tu-correo@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx xxxx xxxx"
EMAIL_VERIFICATION_TTL_MIN=10
EMAIL_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ============================================
# NOTAS
# ============================================
# - PORT lo inyecta Railway automáticamente; no lo definas a mano.
# - Replicas = 1: el migrador de Drizzle no usa advisory lock, así que con
#   varias réplicas las migraciones podrían pisarse.
# - Comprobación de que el servicio está vivo:
#     curl https://TU-SERVICIO.up.railway.app/health
#   Debe responder {"status":"ok",...}
# ============================================
