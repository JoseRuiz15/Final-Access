# Frontend Environment Variables
# Copy to .env.local for local overrides

# Backend API URL. Leave blank locally to use the computer's API on port 3000.
# In production, blank defaults to the same-origin /api proxy in vercel.json.
VITE_API_URL=

# WebSocket URL (optional; derived from VITE_API_URL when blank)
VITE_WS_URL=

# Socket.IO multiplayer URL (optional; defaults to VITE_API_URL, then local port 3001)
VITE_SOCKET_URL=

# ============================================
# EN PRODUCCIÓN (Vercel)
# ============================================
# Configura estas variables en:
#   Vercel > tu proyecto > Settings > Environment Variables
#
# La API REST usa el proxy de Vercel para que la cookie de sesión sea first-party
# en Safari. Los WebSockets siguen conectándose directamente a Render.
# VITE_WS_URL y VITE_SOCKET_URL deben configurarse explícitamente en producción;
# no se derivan correctamente de la URL relativa /api.
#
# VITE_API_URL=/api
# VITE_WS_URL=wss://final-access.onrender.com
# VITE_SOCKET_URL=https://final-access.onrender.com
#
# En Render, define FRONTEND_URL=https://final-access.vercel.app
# y deja COOKIE_DOMAIN vacío. Usa COOKIE_SECURE=true y COOKIE_SAME_SITE=lax
# para la cookie servida por la ruta same-origin /api de Vercel.
