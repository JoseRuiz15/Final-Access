# Frontend Environment Variables
# Copy to .env.local for local overrides

# Backend API URL (development)
VITE_API_URL=http://localhost:3000

# WebSocket URL (development)
VITE_WS_URL=ws://localhost:3000

# ============================================
# EN PRODUCCIÓN (Vercel)
# ============================================
# Configura estas dos variables en:
#   Vercel > tu proyecto > Settings > Environment Variables
#
# El backend vive en Railway y sirve HTTPS, así que la API usa https://
# y el WebSocket wss://. VITE_WS_URL es opcional: si no lo defines se
# deriva de VITE_API_URL (http -> ws, https -> wss).
#
# VITE_API_URL=https://tu-backend.up.railway.app
# VITE_WS_URL=wss://tu-backend.up.railway.app
#
# Recuerda añadir el dominio de Vercel en FRONTEND_URL del backend
# (Railway > Variables), separado por comas si usas previews.
